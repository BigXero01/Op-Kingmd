# ─────────────────────────────────────────────
# Op-Kingmd  –  Environment Configuration
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

# ── Model ─────────────────────────────────────
# Hugging Face model to use as base (can be local path too)
OPKMD_MODEL_ID=Qwen/Qwen2.5-Coder-7B-Instruct
# Path to LoRA adapter (optional, leave blank to use base model)
OPKMD_ADAPTER_PATH=
# Force CPU inference (set to "1" to disable GPU)
OPKMD_FORCE_CPU=0
# Enable 4-bit quantization for low-VRAM environments
OPKMD_QUANTIZE_4BIT=1
# Hugging Face token (required for private models / higher rate limits)
HF_TOKEN=

# ── API Server ────────────────────────────────
OPKMD_HOST=0.0.0.0
OPKMD_PORT=8000
OPKMD_WORKERS=1
OPKMD_API_KEY=change-me-before-production

# ── GitHub Integration ────────────────────────
GITHUB_TOKEN=
GITHUB_DEFAULT_ORG=

# ── Audit Layer ───────────────────────────────
# Risk threshold below which deployment is blocked (0-100)
OPKMD_AUDIT_BLOCK_THRESHOLD=60
# Enable Slither static analysis (requires slither-analyzer installed)
OPKMD_SLITHER_ENABLED=1
# Enable Semgrep rules scan
OPKMD_SEMGREP_ENABLED=1
# Path to save generated audit reports
OPKMD_REPORT_DIR=./audit_reports

# ── Solidity Compiler ─────────────────────────
SOLC_VERSION=0.8.24
# solc-select managed path (auto-detected)
SOLC_PATH=

# ── Blockchain RPCs (for on-chain simulation) ─
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# ── Training ──────────────────────────────────
OPKMD_TRAIN_OUTPUT_DIR=./checkpoints
OPKMD_TRAIN_EPOCHS=3
OPKMD_TRAIN_BATCH_SIZE=4
OPKMD_TRAIN_LR=2e-4
WANDB_PROJECT=op-kingmd
WANDB_API_KEY=
